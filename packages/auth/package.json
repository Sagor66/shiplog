{
  "name": "@shiplog/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./policy": {
      "types": "./dist/password-policy.d.ts",
      "default": "./dist/password-policy.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@shiplog/database": "workspace:*",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.11"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "typescript": "^5.7.3"
  }
}
