# apps/web/.env.example
# Copy to apps/web/.env.local and fill in secrets. Never commit the real env.

NODE_ENV=development

# ---------- Better Auth ----------
# Must be byte-identical to apps/api/.env's BETTER_AUTH_SECRET — cookies
# issued by this app are validated by the NestJS API using the same secret.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public base URL of THIS app. Used by Better Auth for cookie scoping,
# Origin verification, and OAuth callback URLs.
BETTER_AUTH_URL="http://localhost:3000"

# ---------- Database ----------
# The web app imports @shiplog/database to read sessions in Server
# Components and during the Better Auth route handler. Use the SAME
# DATABASE_URL as the API.
DATABASE_URL="postgresql://shiplog:shiplog@localhost:5434/shiplog?schema=public"

# ---------- GitHub OAuth (user sign-in) ----------
# Same credentials as apps/api/.env. The callback URL registered on the
# GitHub OAuth App must be:  ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------- API URL ----------
# Used by client code that needs to reach the NestJS resource API.
NEXT_PUBLIC_API_URL="http://localhost:3333"
