# apps/api/.env.example
# Copy to apps/api/.env and fill in secrets. Never commit the real .env.

NODE_ENV=development
PORT=3333

# ---------- Database ----------
# Local Postgres from docker-compose at repo root. The @shiplog/database
# package reads this on import — if it's missing the process refuses to start.
DATABASE_URL="postgresql://shiplog:shiplog@localhost:5434/shiplog?schema=public"

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"

# ---------- Better Auth ----------
# 32+ bytes of random data — used to sign cookies and OAuth state tokens.
# Generate with:  openssl rand -base64 32
# MUST match the value in apps/web/.env. Cookies issued by one app validate
# against the other only when these are identical.
BETTER_AUTH_SECRET=""

# Public base URL of the WEB app (not this API). Better Auth uses it for:
#   - Setting the cookie domain
#   - Verifying the Origin header on every state-changing request
#   - Constructing OAuth callback URLs
# In dev: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# ---------- GitHub OAuth (user sign-in) ----------
# This is NOT the GitHub App used for repo access — it's a separate OAuth
# App registered for "Sign in with GitHub." Repo access comes later via
# the GitHub App installation flow.
#
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------- GitHub App (separate, for repo access) ----------
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# ---------- AI / Email / Billing / Storage ----------
ANTHROPIC_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM_DOMAIN="updates.shiplog.dev"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_SCALE=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="shiplog-widgets"
R2_PUBLIC_URL="https://cdn.shiplog.dev"

# ---------- Monitoring ----------
SENTRY_DSN=""
POSTHOG_API_KEY=""

# ---------- App ----------
APP_URL="http://localhost:3000"
